{
    "name": "happenv-com/filament-turnstile",
    "description": "Cloudflare Turnstile panel plugin for Filament v5 — register once, auto-protect login (and optionally registration / password reset).",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "turnstile",
        "cloudflare",
        "captcha"
    ],
    "homepage": "https://github.com/happenv-com/filament-turnstile",
    "license": "MIT",
    "authors": [
        {
            "name": "Muazzam Builds",
            "email": "me@muazzamalikhan.com",
            "homepage": "https://github.com/muazzambuilds"
        },
        {
            "name": "Happenv",
            "email": "code@happenv.com",
            "homepage": "https://github.com/happenv-com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentTurnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentTurnstile\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\FilamentTurnstile\\FilamentTurnstileServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
