{
    "name": "happenv-com/filament-turnstile",
    "description": "Cloudflare Turnstile panel plugin for Filament v4 and v5 — register once, auto-protect login (and optionally registration / password reset).",
    "license": "MIT",
    "keywords": [
        "happenv",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-turnstile",
        "turnstile",
        "cloudflare",
        "captcha"
    ],
    "authors": [
        {
            "name": "Happenv sp. z o.o.",
            "email": "code@happenv.com",
            "homepage": "https://happenv.com",
            "role": "Maintainer"
        },
        {
            "name": "webard",
            "email": "code@webard.me",
            "homepage": "https://github.com/webard",
            "role": "Developer"
        },
        {
            "name": "Muazzam Builds",
            "email": "me@muazzamalikhan.com",
            "homepage": "https://github.com/muazzambuilds",
            "role": "Original author"
        }
    ],
    "homepage": "https://github.com/happenv-com/filament-turnstile",
    "support": {
        "issues": "https://github.com/happenv-com/filament-turnstile/issues",
        "source": "https://github.com/happenv-com/filament-turnstile",
        "security": "https://github.com/happenv-com/filament-turnstile/security/policy"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "ergebnis/composer-normalize": "^2.48",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-arch": "^4.0 || ^5.0",
        "pestphp/pest-plugin-browser": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentTurnstile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentTurnstile\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Happenv\\FilamentTurnstile\\FilamentTurnstileServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "ci": [
            "@normalize-composer-test",
            "@rector-test",
            "@pint-test",
            "@phpstan",
            "@test"
        ],
        "cs": [
            "@normalize-composer",
            "@rector",
            "@pint"
        ],
        "normalize-composer": "@composer normalize --ansi",
        "normalize-composer-test": "@composer normalize --dry-run --ansi",
        "phpstan": "phpstan analyse --ansi",
        "pint": "pint",
        "pint-test": "pint --test",
        "rector": "rector process",
        "rector-test": "rector process --dry-run",
        "test": "pest --testsuite=Unit,Feature",
        "test-browser": "pest --testsuite=Browser",
        "test-coverage": "pest --testsuite=Unit,Feature --coverage"
    },
    "scripts-descriptions": {
        "ci": "Runs every CI gate locally: composer.json normalization, Rector, Pint, PHPStan and the test suite.",
        "cs": "Fixes code style: composer normalize, Rector, then Pint (Rector adds imports, Pint sorts them).",
        "normalize-composer": "Normalizes composer.json.",
        "normalize-composer-test": "Checks composer.json is normalized.",
        "phpstan": "Runs PHPStan.",
        "pint": "Formats the code with Pint.",
        "pint-test": "Checks the code style with Pint.",
        "rector": "Applies Rector refactorings.",
        "rector-test": "Shows pending Rector refactorings.",
        "test": "Runs the unit and feature tests.",
        "test-browser": "Runs the browser tests (needs `npx playwright install chromium` once).",
        "test-coverage": "Runs the unit and feature tests with code coverage (needs pcov or Xdebug)."
    }
}
